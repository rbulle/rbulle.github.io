%AXGEndBitmap
GR
GR
GS
[0.48 0 0 0.48018 336.00003 0] CT
[1 0 0 1 0 0] CT
N
-700 0 M
175 0 L
175 656 L
-700 656 L
-700 0 L
cp
clip
GS
0 0 translate
175 131 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 131
  /ImageMatrix [175 0 0 131 0 0]
  /Width 175
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
